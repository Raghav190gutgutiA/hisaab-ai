{
  "name": "hisaab-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Hisaab.ai API server: AI expense tracking agent, web API and Telegram bot",
  "author": "Raghav Gutgutia",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "telegram:set-webhook": "tsx --env-file-if-exists=.env scripts/telegram-webhook.ts set",
    "telegram:webhook-info": "tsx --env-file-if-exists=.env scripts/telegram-webhook.ts info"
  },
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "@langchain/core": "^1.3.0",
    "@langchain/google-genai": "^2.3.4",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/langgraph-checkpoint-mongodb": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "grammy": "^1.46.0",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.5.19",
    "mongodb": "^6.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "mongodb-memory-server"
    ]
  },
  "engines": {
    "node": ">=22.12 <23"
  }
}

# ───────────── App ─────────────
# development | production | test
NODE_ENV=development
# Port the API server listens on
PORT=4100
# Timezone used to decide what "today" and "this month" mean
APP_TIMEZONE=Asia/Kolkata
# Public URL of the web app (Vercel in production): allowed by CORS, used in Telegram links
APP_FRONTEND_URL=http://localhost:5173
# Public URL of this API (Render in production): used to register the Telegram webhook
APP_BACKEND_URL=http://localhost:4100
# Extra browser origins allowed to call the API, comma separated (e.g. Vercel preview URLs)
CORS_ORIGINS=

# ───────────── Database ─────────────
# MongoDB connection string. The database name is the path segment (here: hisaab-ai).
# Production: MongoDB Atlas (TLS is on by default with mongodb+srv).
# Local: mongodb://127.0.0.1:27017/hisaab-ai
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hisaab-ai?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1:27017/hisaab-ai

# ───────────── Auth ─────────────
# Secret for signing login tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_jwt_secret
# How long a login lasts (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# ───────────── Google Gemini ─────────────
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Light tier: tool selection, expense logging and chat replies (fast, cheapest)
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
# Thinking for the light tier: OFF | LOW | MEDIUM | HIGH
GEMINI_LIGHT_THINKING_LEVEL=LOW
# Cap on tokens per light-tier reply
GEMINI_LIGHT_MAX_OUTPUT_TOKENS=512
# Mid tier: generated UI content (analysis insights) and fallback when the light model's output fails validation
GEMINI_MID_MODEL=gemini-3.6-flash
# Thinking for the mid tier: OFF | LOW | MEDIUM | HIGH
GEMINI_MID_THINKING_LEVEL=LOW
# Cap on tokens per mid-tier reply
GEMINI_MID_MAX_OUTPUT_TOKENS=1024
# Retries with backoff for rate limits (429) and server errors (5xx)
GEMINI_MAX_RETRIES=3
# How many recent chat messages are sent to the model each turn
AGENT_HISTORY_MESSAGES=12

# ───────────── Telegram ─────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Bot username without @ (optional: detected automatically from the token)
TELEGRAM_BOT_USERNAME=
# polling (local, use a separate dev bot) | webhook (production) | off
TELEGRAM_MODE=polling
# Secret Telegram sends in X-Telegram-Bot-Api-Secret-Token (letters, digits, _ and - only).
# Required for webhook mode. Use a different value in production.
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret
